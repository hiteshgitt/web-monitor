# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/webmonitor
# For MongoDB Atlas, use: mongodb+srv://username:password@cluster.mongodb.net/webmonitor

# Server Configuration
PORT=5000
NODE_ENV=development

# Accounts
# Long random secret for signing sign-in tokens, e.g. `openssl rand -hex 48`
JWT_SECRET=change_me_to_a_long_random_string
# How long a sign-in lasts
JWT_EXPIRES_IN=30d
# Comma-separated emails that become admins (can switch customers to Pro)
ADMIN_EMAILS=you@example.com
# Google sign-in OAuth client ID(s), comma-separated (web + Android/iOS later)
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Production only
# Comma-separated origins allowed to call the API (the dashboard's URL)
# CORS_ORIGINS=https://monitor.example.com
# Set to 1 when running behind nginx / a load balancer
# TRUST_PROXY=1
# Max API requests per IP per 15 minutes (default 1000 in production)
# RATE_LIMIT_MAX=1000

# API Keys for website monitoring (Generated by your WordPress/Next.js/Laravel apps)
WORDPRESS_API_KEY=your_wordpress_api_key
NEXTJS_API_KEY=your_nextjs_api_key
LARAVEL_API_KEY=your_laravel_api_key
CODEIGNITER_API_KEY=your_codeigniter_api_key

# Monitoring Configuration
MONITORING_INTERVAL=60000
# Days of check history to keep (older checks are deleted automatically)
MONITORING_RETENTION_DAYS=90
HEALTH_CHECK_TIMEOUT=10000

# AI Service Configuration
# Google Gemini API Key (Required for AI features)
GOOGLE_AI_API_KEY=your_google_gemini_api_key_here

# Hours to reuse a site's AI insights before regenerating (saves API quota)
AI_INSIGHTS_CACHE_HOURS=12

# Optional AI alternatives
# OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key
