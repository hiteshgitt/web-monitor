# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/webmonitor
# For MongoDB Atlas, use: mongodb+srv://username:password@cluster.mongodb.net/webmonitor

# Server Configuration
PORT=5000
NODE_ENV=development

# API Keys for website monitoring (Generated by your WordPress/Next.js/Laravel apps)
WORDPRESS_API_KEY=your_wordpress_api_key
NEXTJS_API_KEY=your_nextjs_api_key
LARAVEL_API_KEY=your_laravel_api_key
CODEIGNITER_API_KEY=your_codeigniter_api_key

# Monitoring Configuration
MONITORING_INTERVAL=60000
HEALTH_CHECK_TIMEOUT=10000

# AI Service Configuration
# Google Gemini API Key (Required for AI features)
GOOGLE_AI_API_KEY=your_google_gemini_api_key_here

# Optional AI alternatives
# OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key
