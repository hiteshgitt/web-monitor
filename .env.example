# Copy to .env and fill in before `npm run build`
# Google sign-in OAuth web client ID (public value; never put the client secret here)
VITE_GOOGLE_CLIENT_ID=
# Only if the API is on a different domain than the website (default: same-origin /api)
# VITE_API_URL=https://api.example.com/api

# "Continue with Ruya Lab" sign-in (accounts.ruyalab.com); 1 shows the button
VITE_RUYALAB_SIGNIN=0
